APP_ENV=development
SECRET_KEY=changeme_use_a_real_secret_in_production

DATABASE_URL=postgresql+asyncpg://driftlens:driftlens@localhost:5432/driftlens

QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=driftlens_chunks

OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o
EMBEDDING_MODEL=text-embedding-3-small

CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

OBJECT_STORAGE_PATH=./storage

# Optional: LangSmith tracing
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=driftlens
