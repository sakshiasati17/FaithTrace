# Triton model configuration for the FaithTrace failure classifier.
#
# WHY TRITON over raw FastAPI inference:
# 1. Dynamic batching — groups concurrent requests into GPU batches.
#    8 simultaneous queries → 1 GPU call instead of 8 sequential ones.
# 2. Model versioning — serve v1 and v2 side-by-side for A/B testing.
# 3. Prometheus metrics — /metrics endpoint out of the box.
# 4. Multi-model — embed + classify + rerank from one GPU server,
#    API layer stays on cheap CPU machines.

name: "failure_classifier"
platform: "tensorrt_plan"
max_batch_size: 32

input [
  {
    name: "input_ids"
    data_type: TYPE_INT32
    dims: [512]
  },
  {
    name: "attention_mask"
    data_type: TYPE_INT32
    dims: [512]
  },
  {
    name: "ragas_scores"
    data_type: TYPE_FP32
    dims: [5]
  }
]

output [
  {
    name: "logits"
    data_type: TYPE_FP32
    dims: [6]
  }
]

dynamic_batching {
  # Collect requests for up to 10 ms before dispatching to GPU.
  # Trade-off: slightly higher individual latency, much better throughput.
  max_queue_delay_microseconds: 10000
  preferred_batch_size: [4, 8, 16]
}

version_policy: { latest { num_versions: 2 } }

instance_group [
  {
    count: 1
    kind: KIND_GPU
    gpus: [0]
  }
]
