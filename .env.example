# Copy to .env and fill in real values
# Generate SECRET_KEY with: openssl rand -hex 32
# Generate API_KEY with:    openssl rand -hex 32

# ─── App ──────────────────────────────────────────────────────────────────────
APP_ENV=development
# APP_ENV=production   ← change this in prod (disables /docs, /redoc)

SECRET_KEY=changeme_replace_with_openssl_rand_hex_32

# API key — leave empty to disable auth (dev only).
# In production: set to a strong random value and pass X-API-Key header from frontend.
API_KEY=

# CORS — comma-separated. In prod set to your real domain.
# ALLOWED_ORIGINS=["https://yourdomain.com"]

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://faithtrace:faithtrace@postgres:5432/faithtrace

# ─── Vector DB ────────────────────────────────────────────────────────────────
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=faithtrace_chunks

# ─── LLM ──────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o
EMBEDDING_MODEL=text-embedding-3-small
# Cross-encoder for the "hybrid_reranker" strategy (downloaded from Hugging Face on first use)
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# Max LLM cost per pipeline run (USD). Past it, the run's remaining queries are
# skipped ("budget exceeded") and the run is failed. <= 0 disables the limit.
MAX_COST_PER_RUN_USD=5.0

# ─── Celery / Redis ───────────────────────────────────────────────────────────
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# ─── Storage ──────────────────────────────────────────────────────────────────
OBJECT_STORAGE_PATH=/app/storage
MAX_UPLOAD_SIZE_MB=50

# ML classifier model — shared storage volume (persists across restarts)
ML_CLASSIFIER_PATH=/app/storage/ml_models/xgb_classifier.pkl

# ─── Error tracking (optional) ────────────────────────────────────────────────
# Get DSN from sentry.io — leave empty to disable
SENTRY_DSN=

# ─── LangSmith tracing (optional) ────────────────────────────────────────────
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=faithtrace
