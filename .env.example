# Copy to .env and fill in real values

APP_ENV=development
SECRET_KEY=changeme

DATABASE_URL=postgresql+asyncpg://faithtrace:faithtrace@postgres:5432/faithtrace

QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=faithtrace_chunks

OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o
EMBEDDING_MODEL=text-embedding-3-small

CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

OBJECT_STORAGE_PATH=/app/storage

# ML classifier model path — stored on the shared storage volume so it
# persists across container restarts and is shared between api + workers.
ML_CLASSIFIER_PATH=/app/storage/ml_models/xgb_classifier.pkl

LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=faithtrace
